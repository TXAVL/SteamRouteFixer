<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Steam Dark Cyberpunk Theme Colors -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#171A21"/>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#0E141B"/>
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#0E141B"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1B2838"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2A475E"/>
    <SolidColorBrush x:Key="SubCardBackgroundBrush" Color="#141E28"/>
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#66C0F4"/>
    <SolidColorBrush x:Key="PrimaryAccentButtonBrush" Color="#2A475E"/>
    <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="#1999FF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#5C7E10"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#C1A83E"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#C33B3B"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#C7D5E0"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8F98A0"/>
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#101822"/>
    <SolidColorBrush x:Key="DataGridHeaderForegroundBrush" Color="#66C0F4"/>
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#21354A"/>
    <SolidColorBrush x:Key="DataGridRowSelectedBrush" Color="#2A475E"/>
    <SolidColorBrush x:Key="LogConsoleBackgroundBrush" Color="#0B0E13"/>

    <FontFamily x:Key="SegoeFluentFont">Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="ConsolasFont">Consolas, Cascadia Code, monospace</FontFamily>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">6</CornerRadius>

    <!-- Steam Menu & Dropdown Popup Styles -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#C7D5E0"/>
        <Setter Property="FontFamily" Value="{StaticResource SegoeFluentFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="#2A475E"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="6,4"/>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#C7D5E0"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="templateRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom"
                               PopupAnimation="Fade">
                            <Border Background="#101822"
                                    BorderBrush="#2A475E"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4,6"
                                    Margin="0,2,0,0">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="templateRoot" Property="Background" Value="#2A475E"/>
                            <Setter Property="Foreground" Value="#66C0F4"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuItem">
                            <Setter TargetName="templateRoot" Property="Padding" Value="12,7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource DataGridHeaderBackgroundBrush}"/>
        <Setter Property="Foreground" Value="#66C0F4"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderBrush" Value="#2A475E"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#C7D5E0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="0,4"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="#1E2C3D"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DataGridRowHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource DataGridRowSelectedBrush}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinUI3PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#2A475E"/>
        <Setter Property="Foreground" Value="#66C0F4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#66C0F4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#3B6384"/>
                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="#FFFFFF"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#1B2838"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinUI3SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#1E2A38"/>
        <Setter Property="Foreground" Value="#C7D5E0"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#31485E"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#2D3E52"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinUI3DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource WinUI3SecondaryButtonStyle}">
        <Setter Property="Background" Value="#4C1B1B"/>
        <Setter Property="BorderBrush" Value="#8A2A2A"/>
        <Setter Property="Foreground" Value="#FF8888"/>
    </Style>

    <Style x:Key="FilterChipButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#17202B"/>
        <Setter Property="Foreground" Value="#8F98A0"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#2A3D50"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="chipBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chipBorder" Property="BorderBrush" Value="#66C0F4"/>
                            <Setter TargetName="chipBorder" Property="Background" Value="#203040"/>
                            <Setter Property="Foreground" Value="#66C0F4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top Tab Bar Header Strip -->
                        <Border Grid.Row="0"
                                Background="#0E141B"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="8,4,8,0">
                            <TabPanel IsItemsHost="True" Background="Transparent"/>
                        </Border>

                        <!-- Active Selected Tab Content -->
                        <Border Grid.Row="1" Background="Transparent" Padding="0,6,0,0">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#8F98A0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="tabBorder"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,3"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,0,8,0"
                            CornerRadius="4,4,0,0"
                            Cursor="Hand">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter TargetName="tabBorder" Property="Background" Value="#1066C0F4"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#66C0F4"/>
                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="#66C0F4"/>
                            <Setter TargetName="tabBorder" Property="Background" Value="#2066C0F4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="#121820"/>
        <Setter Property="Foreground" Value="#66C0F4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            ClipToBounds="True">
                        <Grid x:Name="TemplateRoot">
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
