<Window x:Class="SteamRouteFixer.Views.AboutModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giới thiệu - Steam Route Fixer" Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource SegoeFluentFont}">

    <Border Padding="24" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header & App Branding -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Image Source="pack://application:,,,/SteamRouteFixer;component/Assets/app.png" Width="52" Height="52" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Steam Route Fixer" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                        <TextBlock Text="Tool Steam Route Fixer &amp; HTTP/HTTPS Traffic Inspector" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="Phát triển bởi TXA Studio • Version 1.0 (Build 2026.08)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Separator Background="{DynamicResource CardBorderBrush}" Height="1"/>
            </StackPanel>

            <!-- 2. Detailed Technical & Feature Info -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="16" Margin="0,0,0,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="🎮 Về ứng dụng Steam Route Fixer" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" LineHeight="17">
                            Ứng dụng chuyên nghiệp giúp game thủ Việt Nam tự động quét, chẩn đoán và khắc phục triệt để tình trạng lỗi kết nối mạng Steam (Steam Store, Community, Friends, Cloud Sync) bằng kỹ thuật tối ưu hóa định tuyến IP sạch chuẩn xác, hoàn toàn không cần cài đặt VPN hay phần mềm bên thứ 3.
                        </TextBlock>

                        <TextBlock Text="⚡ Các tính năng cốt lõi" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <StackPanel Margin="6,0,0,12">
                            <TextBlock Text="• 1-Click Auto Fix: Tự động phát hiện lỗi và ghim IP sạch vào hosts." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                            <TextBlock Text="• Giám sát lưu lượng HTTP/HTTPS &amp; TCP Socket theo thời gian thực." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                            <TextBlock Text="• Hệ thống bảo vệ Steam Sentinel &amp; Tự động sao lưu file hosts." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                            <TextBlock Text="• Giao diện Microsoft WinUI 3 Fluent Dark sắc nét, độ tương phản cao." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                        </StackPanel>

                        <TextBlock Text="🛠️ Thông tin kỹ thuật &amp; Mã nguồn" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" LineHeight="16">
                            Framework: .NET 10 (Desktop Runtime) • Windows Native Win32 API&#x0a;
                            Repository: https://github.com/TXAVL/SteamRouteFixer&#x0a;
                            Bản quyền © 2026 TXA Studio. All rights reserved.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 3. Bottom Action Buttons -->
            <Grid Grid.Row="2">
                <Button Content="🌐 Mở GitHub Repo" Style="{DynamicResource WinUI3SecondaryButtonStyle}" HorizontalAlignment="Left" Padding="14,7" Click="BtnGithub_Click"/>
                <Button Content="Đóng" Style="{DynamicResource WinUI3PrimaryButtonStyle}" HorizontalAlignment="Right" Width="90" Click="BtnClose_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
