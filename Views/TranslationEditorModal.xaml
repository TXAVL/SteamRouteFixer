<Window x:Class="SteamRouteFixer.Views.TranslationEditorModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biên dịch Ngôn ngữ - TXA Language Translator"
        Height="700" Width="960"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource SegoeFluentFont}">

    <Border Padding="20" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Top Config (Target Lang + Author) -->
                <RowDefinition Height="*"/>    <!-- Translation Items List -->
                <RowDefinition Height="Auto"/> <!-- Bottom Status & Actions -->
            </Grid.RowDefinitions>

            <!-- 1. Header & Guide -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🌐" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTranslatorMainTitle" Text="TRÌNH BIÊN DỊCH NGÔN NGỮ (TXA TRANSLATOR)" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                        <TextBlock x:Name="TxtTranslatorMainSub" Text="Biên dịch toàn bộ giao diện từ Tiếng Anh chuẩn sang ngôn ngữ mong muốn. Tiến độ nháp tự động lưu liên tục."
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Separator Background="{DynamicResource CardBorderBrush}" Height="1" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- 2. Target Lang & Author Selection Card -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="14,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Target Language Dropdown -->
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TxtTargetLangLabel" Text="🎯 CHỌN NGÔN NGỮ ĐÍCH BIÊN DỊCH:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource PrimaryAccentBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbTargetCulture"
                                  Padding="10,6" FontSize="12"
                                  SelectionChanged="CmbTargetCulture_SelectionChanged"/>
                    </StackPanel>

                    <!-- Author Name -->
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="TxtAuthorLabel" Text="✍️ TÊN / NICKNAME TÁC GIẢ BẢN DỊCH:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource PrimaryAccentBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtAuthor"
                                 Padding="10,6" FontSize="12"
                                 Background="{DynamicResource SubCardBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource CardBorderBrush}"
                                 CaretBrush="{DynamicResource PrimaryAccentBrush}"
                                 TextChanged="TxtAuthor_TextChanged"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Two-Column Translation Table (Scrollable List) -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="4" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Table Header -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Rows -->
                    </Grid.RowDefinitions>

                    <!-- Column Header Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}" Padding="12,8" CornerRadius="4,4,0,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="420"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtColSourceHeader" Grid.Column="0" Text="🔤 VĂN BẢN TIẾNG ANH GỐC (SOURCE EN-US)" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtColTargetHeader" Grid.Column="1" Text="✏️ BẢN DỊCH NGÔN NGỮ ĐÍCH CỦA BẠN (TARGET TRANSLATION)" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource PrimaryAccentBrush}" Margin="12,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Scrollable Items Container -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ItemsTranslationList" Margin="8,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="6,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="410"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: Key & English Source & Variable Notice Badge -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Key}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas"/>
                                                <TextBlock Text="{Binding EnglishText}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                <Border Background="#20FFA500" BorderBrush="#66FFA500" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left" Visibility="{Binding VariableBadgeVisibility}">
                                                    <TextBlock Text="{Binding VariablesHint}" Foreground="#FFB900" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Right: Target Translation TextBox & Error Alert -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBox Text="{Binding TranslatedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="10,6" FontSize="12"
                                                         Background="{DynamicResource SubCardBackgroundBrush}"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         BorderBrush="{Binding InputBorderBrushColor, Mode=OneWay}"
                                                         BorderThickness="1.5"
                                                         CaretBrush="{DynamicResource PrimaryAccentBrush}"
                                                         TextChanged="TranslationTextBox_TextChanged"/>
                                                <TextBlock Text="{Binding ValidationErrorMessage}"
                                                           Foreground="#FF5252" FontSize="11" FontWeight="SemiBold"
                                                           Margin="2,4,0,0"
                                                           Visibility="{Binding ValidationWarningVisibility}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 4. Bottom Status & Actions -->
            <Border Grid.Row="3"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Progress Status -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtProgressSummary" Text="Tiến độ dịch: 0 / 48 chuỗi (0%)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtDraftStatus" Text=" • Đã lưu nháp tự động" FontSize="11" Foreground="#57AB5A" Margin="6,0,0,0"/>
                        </StackPanel>
                        <ProgressBar x:Name="PbTranslationProgress" Height="6" Maximum="100" Value="0" Margin="0,6,16,0"
                                     Foreground="{DynamicResource PrimaryAccentBrush}" Background="{DynamicResource WindowBackgroundBrush}"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Submit to GitHub (Enabled at 100%) -->
                        <Button x:Name="BtnSubmitGithub" Content="🚀 Gửi Lên GitHub (100%)"
                                Style="{DynamicResource WinUI3SecondaryButtonStyle}"
                                IsEnabled="False" Margin="0,0,8,0" Click="BtnSubmitGithub_Click"/>

                        <!-- Save & Apply -->
                        <Button x:Name="BtnSaveAndApply" Content="💾 Lưu &amp; Áp Dụng (.txal)"
                                Style="{DynamicResource WinUI3PrimaryButtonStyle}"
                                Margin="0,0,8,0" Click="BtnSaveAndApply_Click"/>

                        <!-- Close -->
                        <Button x:Name="BtnCloseTrans" Content="Đóng"
                                Style="{DynamicResource WinUI3SecondaryButtonStyle}"
                                Width="80" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
