<Window x:Class="SteamRouteFixer.Views.RequestDetailModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Chi Tiết HTTP Request &amp; Response"
        Height="620" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource SegoeFluentFont}">

    <Window.Resources>
        <Storyboard x:Key="CopySuccessAnimation">
            <ColorAnimation Storyboard.TargetName="BtnCopyResponseBorder"
                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                            To="#00CC6A" Duration="0:0:0.15" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="BtnCopyResponseScale"
                             Storyboard.TargetProperty="ScaleX"
                             To="1.08" Duration="0:0:0.1" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="BtnCopyResponseScale"
                             Storyboard.TargetProperty="ScaleY"
                             To="1.08" Duration="0:0:0.1" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="TxtCopyNotice"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0" Duration="0:0:1.8"/>
        </Storyboard>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Card -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CardCornerRadius}"
                Padding="14,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="🔍 THÔNG TIN CHI TIẾT REQUEST &amp; RESPONSE"
                               FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource PrimaryAccentBrush}"/>
                    <TextBlock x:Name="TxtFullUrl"
                               Text="https://store.steampowered.com/api/IStoreService/..."
                               FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="BadgeMethod" Background="#0078D4" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtMethod" Text="HTTPS GET" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                    </Border>
                    <Border x:Name="BadgeStatus" Background="#107C41" CornerRadius="4" Padding="8,3">
                        <TextBlock x:Name="TxtStatus" Text="200 OK" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Metadata Summary Row -->
        <Border Grid.Row="1"
                Background="{DynamicResource SubCardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                Padding="12,8"
                Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="📱 Tiến trình: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="TxtProcess" Text="steam.exe (PID: 8420)" FontWeight="SemiBold" Margin="0,0,18,0"/>

                <TextBlock Text="🌐 Remote: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="TxtRemote" Text="118.68.82.144:443" FontWeight="SemiBold" Margin="0,0,18,0"/>

                <TextBlock Text="⏱ Độ trễ: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="TxtDuration" Text="28 ms" FontWeight="SemiBold" Margin="0,0,18,0"/>

                <TextBlock Text="📦 Request Size: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="TxtReqSize" Text="512 B" FontWeight="SemiBold" Margin="0,0,18,0"/>

                <TextBlock Text="📥 Response Size: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="TxtRespSize" Text="1.84 KB" FontWeight="SemiBold"/>
            </WrapPanel>
        </Border>

        <!-- Tabs for Request & Response -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <!-- Response Tab (Primary) -->
            <TabItem Header="📤 RESPONSE (PHẢN HỒI)" FontWeight="SemiBold" FontSize="12">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Response Headers &amp; Payload:"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>

                    <TextBox Grid.Row="1" x:Name="TxtResponseBody"
                             Background="{DynamicResource SubCardBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource CardBorderBrush}"
                             FontFamily="{DynamicResource ConsolasFont}"
                             FontSize="12"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Padding="10"/>
                </Grid>
            </TabItem>

            <!-- Request Tab -->
            <TabItem Header="📥 REQUEST (YÊU CẦU)" FontWeight="SemiBold" FontSize="12">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Request Headers &amp; Body:"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>

                    <TextBox Grid.Row="1" x:Name="TxtRequestBody"
                             Background="{DynamicResource SubCardBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource CardBorderBrush}"
                             FontFamily="{DynamicResource ConsolasFont}"
                             FontSize="12"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Padding="10"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Action Bar with Animated Copy Response Button -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Copy Success Toast Notification -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtCopyNotice"
                           Text="✨ Đã sao chép vào Clipboard thành công!"
                           Foreground="#00CC6A"
                           FontWeight="SemiBold"
                           Opacity="0.0"
                           Margin="4,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnCopyUrl" Content="📋 Copy URL"
                        Style="{DynamicResource WinUI3SecondaryButtonStyle}"
                        Margin="0,0,8,0" Click="BtnCopyUrl_Click"/>

                <Button x:Name="BtnCopyRequest" Content="📋 Copy Request"
                        Style="{DynamicResource WinUI3SecondaryButtonStyle}"
                        Margin="0,0,8,0" Click="BtnCopyRequest_Click"/>

                <!-- Special Animated Glowing Copy Response Button -->
                <Button x:Name="BtnCopyResponse"
                        Cursor="Hand"
                        Click="BtnCopyResponse_Click"
                        Padding="16,8"
                        Background="#0E639C"
                        BorderBrush="#4CC2FF"
                        BorderThickness="1">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnCopyResponseBorder"
                                    Background="#0E639C"
                                    BorderBrush="#4CC2FF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="16,8"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="BtnCopyResponseScale" ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtCopyIcon" Text="✨ 📋 " FontSize="12" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="TxtCopyButtonLabel" Text="COPY RESPONSE (BODY)" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="Đóng" Style="{DynamicResource WinUI3SecondaryButtonStyle}"
                        Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
