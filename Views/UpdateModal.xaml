<Window x:Class="SteamRouteFixer.Views.UpdateModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiểm tra Cập nhật - Steam Route Fixer" Height="500" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource SegoeFluentFont}">

    <Border Padding="24" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header & Live Status -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Image Source="pack://application:,,,/SteamRouteFixer;component/Assets/app.png" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cập Nhật Phần Mềm" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                        <TextBlock Text="Kiểm tra phiên bản mới từ GitHub TXAVL/SteamRouteFixer" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Border Background="{DynamicResource SubCardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TxtCurrentVersion" Text="Phiên bản hiện tại: v1.0.0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtUpdateStatus" Text="Nhấn 'Kiểm Tra Ngay' để kết nối tới GitHub Releases."
                                       FontSize="11.5" Foreground="{DynamicResource PrimaryAccentBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1" x:Name="BtnCheckUpdate" Content="🔄 Kiểm Tra Ngay"
                                Style="{DynamicResource WinUI3SecondaryButtonStyle}"
                                Padding="12,6" FontSize="11.5" VerticalAlignment="Center" Click="BtnCheckUpdate_Click"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 2. Release Notes & Changelog Details -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="14" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📋 Thông tin bản phát hành:" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="TxtChangelog"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 FontSize="11.5"
                                 FontFamily="{DynamicResource ConsolasFont}"
                                 Text="Chưa có thông tin phát hành. Vui lòng bấm nút 'Kiểm Tra Ngay'."/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 3. Bottom Actions & Download Progress -->
            <Grid Grid.Row="2">
                <ProgressBar x:Name="DownloadProgressBar" Height="6" Value="0" Maximum="100"
                             Background="#252525" Foreground="{DynamicResource PrimaryAccentBrush}"
                             Visibility="Collapsed" VerticalAlignment="Top" Margin="0,-12,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BtnDownloadUpdate" Content="⬇ Tải Bản Cập Nhật Mới"
                            Style="{DynamicResource WinUI3PrimaryButtonStyle}"
                            Visibility="Collapsed" Margin="0,0,8,0" Click="BtnDownloadUpdate_Click"/>
                    <Button Content="🌐 Mở GitHub Releases" Style="{DynamicResource WinUI3SecondaryButtonStyle}" Click="BtnOpenGithub_Click"/>
                </StackPanel>

                <Button Content="Đóng" Style="{DynamicResource WinUI3SecondaryButtonStyle}" HorizontalAlignment="Right" Width="80" Click="BtnClose_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
