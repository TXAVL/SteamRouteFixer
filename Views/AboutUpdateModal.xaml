<Window x:Class="SteamRouteFixer.Views.AboutUpdateModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Giới Thiệu &amp; Cập Nhật - Steam Route Fixer"
        Height="540" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource SegoeFluentFont}">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header & App Info -->
                <RowDefinition Height="*"/>    <!-- Changelog & Update Box -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header & App Info -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Image Source="pack://application:,,,/SteamRouteFixer;component/Assets/app.png" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Steam Route Fixer" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                        <TextBlock Text="Tool Steam Route Fixer &amp; HTTP/HTTPS Traffic Inspector by TXA" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Border Background="{DynamicResource SubCardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Phiên bản: 1.0 (Build 2026.08)" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="Phát triển bởi: TXA Studio" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Nền tảng: .NET 10 (WinUI 3 Fluent)" FontSize="12"/>
                            <TextBlock Text="Bản quyền: © 2026 TXA Studio" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 2. Update Check & Changelog Box -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="14" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🔄 TRẠNG THÁI CẬP NHẬT (LIVE UPDATER)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryAccentBrush}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" x:Name="TxtUpdateStatus" Text="Nhấn 'Kiểm Tra Bản Mới' để đồng bộ với máy chủ TXA Studio..." FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>

                    <!-- Changelog Viewer -->
                    <Border Grid.Row="2" Background="{DynamicResource SubCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtChangelog" Text="Changelog phiên bản v1.0:&#x0a;• Ra mắt bộ công cụ Steam Route Fixer &amp; HTTP/HTTPS Traffic Inspector do TXA Studio phát triển.&#x0a;• Tự động thu thập IP sạch qua DoH &amp; UDP DNS bypass nhà mạng VN.&#x0a;• Giám sát HTTP/HTTPS traffic theo từng Process với format size động.&#x0a;• Bộ theme WinUI 3 Fluent Mica, Steam Cyberpunk và VS Code Studio."
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontFamily="{DynamicResource ConsolasFont}"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Download Progress Bar -->
                    <ProgressBar Grid.Row="3" x:Name="DownloadProgressBar" Height="6" Value="0" Maximum="100" Visibility="Collapsed"
                                 Background="#252525" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                </Grid>
            </Border>

            <!-- 3. Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCheckUpdate" Content="🔄 Kiểm Tra Bản Mới"
                        Style="{DynamicResource WinUI3SecondaryButtonStyle}"
                        Margin="0,0,10,0" Click="BtnCheckUpdate_Click"/>

                <Button x:Name="BtnDownloadUpdate" Content="📥 Tải Về &amp; Cập Nhật"
                        Style="{DynamicResource WinUI3PrimaryButtonStyle}"
                        Margin="0,0,10,0" Visibility="Collapsed" Click="BtnDownloadUpdate_Click"/>

                <Button Content="Đóng"
                        Style="{DynamicResource WinUI3SecondaryButtonStyle}"
                        Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
