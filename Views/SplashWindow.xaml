<Window x:Class="SteamRouteFixer.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Khởi Động Steam Route Fixer"
        Height="240" Width="490"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Border Background="#171A21"
            BorderBrush="#0078D4"
            BorderThickness="1.5"
            CornerRadius="12"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo & App Title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/SteamRouteFixer;component/Assets/app.png" Width="44" Height="44" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="STEAM ROUTE FIXER" FontWeight="Bold" FontSize="16" Foreground="#4CC2FF"/>
                    <TextBlock Text="Tool Steam Route Fixer &amp; Traffic Inspector by TXA" FontSize="11.5" Foreground="#8F98A0"/>
                </StackPanel>
            </StackPanel>

            <!-- Status Message -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatus" Text="Đang khởi tạo các module chẩn đoán mạng và kiểm tra Steam..."
                           Foreground="#C7D5E0" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Progress Bar -->
            <ProgressBar Grid.Row="2" x:Name="SplashProgressBar" Height="5"
                         IsIndeterminate="True"
                         Background="#252525" Foreground="#0078D4" Margin="0,0,0,10"/>

            <!-- Footer Version & TXA Studio -->
            <Grid Grid.Row="3">
                <TextBlock Text="TXA Studio • .NET 10 WinUI 3 Fluent" FontSize="10.5" Foreground="#5A6570"/>
                <TextBlock Text="v1.0" FontSize="10.5" FontWeight="Bold" Foreground="#4CC2FF" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</Window>
