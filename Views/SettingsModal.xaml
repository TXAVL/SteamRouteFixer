<Window x:Class="SteamRouteFixer.Views.SettingsModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cài Đặt Hệ Thống &amp; Giao Diện"
        Height="540" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource SegoeFluentFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⚙️ THIẾT LẬP CẤU HÌNH ỨNG DỤNG"
                   FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}"
                   Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <!-- Theme Selection Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="🎨 GIAO DIỆN &amp; PHONG CÁCH (THEME)"
                                   FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryAccentBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Chọn giao diện hiển thị phù hợp với sở thích của bạn:"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbThemeWinUI3" Content="WinUI 3 (Windows 11 Fluent Mica)"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         Margin="0,0,16,0" Checked="RbTheme_Checked"/>
                            <RadioButton x:Name="RbThemeSteam" Content="Steam Dark (Cyberpunk Glow)"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         Margin="0,0,16,0" Checked="RbTheme_Checked"/>
                            <RadioButton x:Name="RbThemeVSCode" Content="VS Code Studio Dark"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         Checked="RbTheme_Checked"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Steam Path Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="🎮 ĐƯỜNG DẪN STEAM TÙY CHỌN"
                                   FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryAccentBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Nếu bạn cài Steam ở ổ đĩa khác và công cụ chưa tự nhận diện, hãy chọn file steam.exe:"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtSteamPath"
                                     Background="{DynamicResource SubCardBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource CardBorderBrush}"
                                     Padding="8,6" FontSize="12"/>

                            <Button Grid.Column="1" Content="📁 Chọn file steam.exe"
                                    Style="{DynamicResource WinUI3SecondaryButtonStyle}"
                                    Margin="8,0,0,0" Click="BtnBrowseSteam_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hosts Backup Management Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="🛡️ SAO LƯU &amp; KHÔI PHỤC FILE HOSTS"
                                   FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryAccentBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Danh sách các bản sao lưu tự động trong %LocalAppData%\SteamRouteFixer\backups\:"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                        <ListBox x:Name="LstBackups" Height="90"
                                 Background="{DynamicResource SubCardBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource CardBorderBrush}"
                                 Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="🔄 Khôi Phục Bản Chọn"
                                    Style="{DynamicResource WinUI3SecondaryButtonStyle}"
                                    Margin="0,0,8,0" Click="BtnRestoreBackup_Click"/>
                            <Button Content="📂 Mở Thư Mục AppData"
                                    Style="{DynamicResource WinUI3SecondaryButtonStyle}"
                                    Click="BtnOpenAppData_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Button Content="💾 Lưu Cấu Hình" Style="{DynamicResource WinUI3PrimaryButtonStyle}"
                    HorizontalAlignment="Right" Click="BtnSave_Click"/>
            <Button Content="Hủy" Style="{DynamicResource WinUI3SecondaryButtonStyle}"
                    HorizontalAlignment="Right" Margin="0,0,130,0" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
